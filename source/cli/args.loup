@mode(host.dual)

# Command-line parsing for ren. ren has no switches of its own: `/?` asks
# for help, and every other argument (including `/X` and `-X`) is a name,
# following the Windows switch convention in win/switches.loup.

from win.switches import (SwitchSpec, parse_switches, switch_error_message);

pub struct Options {
    pub help: bool;
    pub version: bool;
    pub operands: list[string];
}

# The switches ren declares: none.
pub func ren_switches(): list[SwitchSpec] {
    let none: list[SwitchSpec] = [];
    return none;
}

# The statement form of `match` (arms that return) is deliberate: a match
# expression whose arms build new values returns freed memory natively.
pub func parse_args(argv: list[string]): Result[Options, string] {
    let parsed = match parse_switches(argv, ren_switches()) {
        Ok(p) => p,
        Err(e) => {
            return Err(switch_error_message(e));
        },
    };
    return Ok(Options(
        help = parsed.help,
        version = parsed.version,
        operands = parsed.operands,
    ));
}
