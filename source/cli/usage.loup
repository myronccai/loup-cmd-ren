@mode(host.dual)

from appinfo import (APP_NAME, APP_VERSION);

# The text of `ren /?`: a short summary of this recreation's syntax.
pub func usage(): string {
    let lines = [
        "Rename a file or directory, or several files with wildcards.",
        "",
        "REN [path]name newname",
        "RENAME is the same command.",
        "",
        "  name     A file or directory, or a pattern with * and ?.",
        "  newname  The new name, in the same directory (no path allowed).",
        "           Wildcards in it keep parts of each old name:",
        "           *.txt *.bak, a?.log b?.log, file.* new.*",
    ];
    return lines.join("\n");
}

pub func version_line(): string {
    return i"{$ APP_NAME $} (loup-cmd-{$ APP_NAME $}) {$ APP_VERSION $}";
}
