@mode(host.dual)

# Application identity of ren: name, version, one-line summary and exit
# statuses. Keep APP_NAME and APP_VERSION in step with `name` and `version` in
# package.lppkg.
#
# Runtime: host.dual. Compiled into the native binary build/ren by
# `make build`; `loup run source/main.loup` interprets the same code.

pub const APP_NAME: string = "ren";
pub const APP_VERSION: string = "0.1.0";
pub const APP_SUMMARY: string = "Rename files with cmd's wildcard rules (a Loup recreation of the Windows ren and rename commands).";

# Exit statuses returned by main(). Like cmd.exe's ren, a usage error is
# ERRORLEVEL 1, the same as a name that could not be changed.
pub const EXIT_OK: int = 0;
pub const EXIT_FAILURE: int = 1;
