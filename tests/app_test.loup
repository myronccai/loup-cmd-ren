@mode(host.dual)

# Exit statuses of the whole command line. These tests print the program's
# error messages.

from debug.assert import (expect, expectEq);
from io.fs import (createDir, writeText, removeDir, isDir, isFile);
from appinfo import (EXIT_OK, EXIT_FAILURE);
from cli.app import (run);

func test_version_succeeds(): void {
    expectEq(run(["--version"]), EXIT_OK, "--version");
}

func test_help_succeeds(): void {
    expectEq(run(["/?"]), EXIT_OK, "/?");
}

func test_wrong_operand_count_fails(): void {
    expectEq(run(["a"]), EXIT_FAILURE, "one operand");
}

func test_rename(): void {
    let root = "build/tmp/app_ren";
    if (isDir(root)) {
        removeDir(root);
    }
    createDir(root);
    writeText(root + "/t.txt", "tests pass\n");
    expectEq(run([root + "\\t.txt", "u.txt"]), EXIT_OK, "renamed");
    expect(isFile(root + "/u.txt"), "the new name");
    expectEq(run([root + "/t.txt", "v.txt"]), EXIT_FAILURE, "gone");
    removeDir(root);
}
