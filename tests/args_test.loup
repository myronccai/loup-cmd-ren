@mode(host.dual)

# Unit tests for ren's argument parsing (cli/args.loup): ren declares no
# switches, so every argument other than a help or version request and `--` is
# a name.
#
# Runtime: host.dual, run by the test runner: `make test` interprets this file
# with `loup-bootstrap test --no-parallel` (Stage0, source/ on LOUPPATH), one
# test per `func test_*()`. It is not part of the binary.

from debug.assert import (expect, expectEq);
from cli.args import (parse_args, ren_switches);

func test_operands(): void {
    let opts = parse_args(["*.txt", "*.bak"]).unwrap();
    expectEq(opts.operands.join(","), "*.txt,*.bak", "two operands");
    expectEq(ren_switches().len(), 0, "no switches");
}

func test_everything_is_a_name(): void {
    expectEq(parse_args(["/s", "-q"]).unwrap().operands.len(), 2, "/s and -q are names");
}

func test_help_and_version(): void {
    expect(parse_args(["/?"]).unwrap().help, "/?");
    expect(parse_args(["a", "-?"]).unwrap().help, "-?");
    expect(parse_args(["--help"]).unwrap().help, "--help");
    expect(parse_args(["--version"]).unwrap().version, "--version");
    expect(!parse_args(["--", "/?"]).unwrap().help, "/? after --");
}
